# NB OC Monitor panel. Op de droplet maakt deploy/setup.sh dit bestand aan (als deploy/.env).

APP_NAME="OC Monitor"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://ocm.nextbuzz.nl
APP_LOCALE=nl
APP_FALLBACK_LOCALE=en
APP_TIMEZONE=UTC

LOG_CHANNEL=stderr
LOG_LEVEL=info

DB_CONNECTION=mysql
DB_HOST=mysql
DB_PORT=3306
DB_DATABASE=ocmonitor
DB_USERNAME=ocmonitor
DB_PASSWORD=

HASH_DRIVER=argon2id

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_SECURE_COOKIE=true
SESSION_SAME_SITE=strict

CACHE_STORE=database
QUEUE_CONNECTION=database
MAIL_MAILER=log

# Publieke panel-sleutel (php artisan ocm:keygen). De private sleutel staat ALLEEN in signer.env.
OCM_PANEL_PUBLIC_KEY=

# Eerste admin-account (alleen gebruikt als er nog geen gebruikers zijn).
OCM_ADMIN_EMAIL=
OCM_ADMIN_PASSWORD=
# Wachtwoord of 2FA kwijt? Zet tijdelijk op 1 en herstart: het account uit OCM_ADMIN_EMAIL krijgt
# OCM_ADMIN_PASSWORD als wachtwoord en moet 2FA opnieuw instellen. Zet daarna weer op 0.
OCM_RESET_ADMIN=0

OCM_HEARTBEAT_MINUTES=15
